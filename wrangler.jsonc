{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "jaja-geneva-vocab",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
