<view class="page"><view wx:if="{{word}}" class="card"><view class="term">{{word.text}}</view><view class="sub">{{word.phonetic}}</view><view class="title">{{word.translation}}</view><view wx:if="{{word.example}}" class="space">{{word.example}}</view><view wx:if="{{word.exampleZh}}" class="meaning">{{word.exampleZh}}</view><view wx:if="{{word.roots}}" class="space"><view class="sub">词根词缀</view>{{word.roots}}</view><view wx:if="{{word.extension}}" class="space"><view class="sub">拓展解释</view>{{word.extension}}</view><view class="row space"><button class="btn negative" data-status="forgotten" bindtap="mark">忘记了</button><button class="btn" data-status="remembered" bindtap="mark">记住了</button></view></view><view wx:else class="card">未找到词条</view></view>
