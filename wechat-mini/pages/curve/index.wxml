<view class="page"><view class="title">记忆曲线</view><view class="sub">最近 7 天标记 {{total}} 次。重复复习会累计。</view><view class="card"><view style="display:flex;align-items:flex-end;justify-content:space-between;height:220rpx"><view wx:for="{{days}}" wx:key="date" style="display:flex;align-items:flex-end;gap:4rpx"><view style="width:22rpx;height:{{item.rememberedHeight}}rpx;background:#16704a;border-radius:6rpx"></view><view style="width:22rpx;height:{{item.forgottenHeight}}rpx;background:#c45c4a;border-radius:6rpx"></view></view></view><view style="display:flex;justify-content:space-between;margin-top:14rpx"><text wx:for="{{days}}" wx:key="date" class="small muted">{{item.label}}</text></view><view class="sub space">绿色：记住　红色：忘记</view></view><view class="card" wx:for="{{days}}" wx:key="date"><view class="row"><text>{{item.date}}</text><text>共 {{item.studied}} 次</text></view><view class="meaning">记住 {{item.remembered}} · 忘记 {{item.forgotten}}</view></view><button class="btn negative" bindtap="reset">重置学习进度</button></view>
