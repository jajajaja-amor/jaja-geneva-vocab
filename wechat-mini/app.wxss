page{background:#f6f3ec;color:#20352e;font-size:30rpx}view,text,button,input,textarea{box-sizing:border-box}.page{padding:30rpx 30rpx 80rpx}.title{font-size:44rpx;font-weight:700;margin:14rpx 0}.sub{color:#67756f;font-size:26rpx;line-height:1.5}.card{background:#fff;border-radius:24rpx;padding:32rpx;margin:22rpx 0;box-shadow:0 6rpx 28rpx rgba(24,52,40,.06)}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.term{font-size:40rpx;font-weight:700}.meaning{color:#5c6963;font-size:27rpx;margin-top:8rpx}.btn{background:#16704a;color:#fff;border-radius:16rpx;margin:20rpx 0;font-size:29rpx}.btn.light{background:#e5f1e9;color:#166a47}.btn.negative{background:#f8e8e4;color:#a44436}.btn[disabled]{opacity:.45}.pill{display:inline-block;background:#e7eee9;border-radius:99rpx;padding:8rpx 18rpx;font-size:24rpx;margin:8rpx}.input,.textarea{background:#fff;border:1rpx solid #d8e2d9;border-radius:15rpx;padding:20rpx;width:100%;margin:18rpx 0}.textarea{height:280rpx}.muted{color:#78867e}.center{text-align:center}.space{margin-top:30rpx}.small{font-size:24rpx}
